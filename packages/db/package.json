{
  "name": "@whatsapp-ai/db",
  "version": "0.0.1",
  "type": "module",
  "description": "Shared Prisma schema and generated client for whatsapp-ai-platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generated/prisma": {
      "import": "./dist/generated/prisma/client.js",
      "types": "./dist/generated/prisma/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "generate": "prisma generate && tsc --project tsconfig.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "clean": "rm -rf src/generated && rm -rf dist"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
