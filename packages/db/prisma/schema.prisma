// ============================================================
// WhatsApp AI Platform - Centralized Prisma Schema
// Single source of truth for API and Worker
// ============================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp"), pgvector(map: "vector")]
}

// ============================================================
// ENUMS
// ============================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ConversationState {
  IDLE
  GREETING
  COLLECTING_SERVICE
  COLLECTING_DATE
  COLLECTING_TIME
  CONFIRMING_BOOKING
  BOOKING_CONFIRMED
  HUMAN_HANDOFF
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  TEMPLATE
  INTERACTIVE
  MEDIA
  SYSTEM
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  EMBEDDING
  READY
  ARCHIVED
  FAILED
}

enum WhatsAppVerificationStatus {
  PENDING
  VERIFIED
  NOT_VERIFIED
  FLAGGED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum BookingSource {
  WHATSAPP
  DASHBOARD
  MANUAL
}

enum ReminderRuleType {
  PRE_APPOINTMENT_24H
  PRE_APPOINTMENT_2H
  POST_APPOINTMENT_4H
  RE_BOOKING_30D
  PAYMENT_1D
}

enum ScheduledReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum CustomerOptInStatus {
  OPTED_IN
  OPTED_OUT
  PENDING
}

enum TemplateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
}

enum UsageEventType {
  MESSAGE_INBOUND
  MESSAGE_OUTBOUND
  AI_CALL
  BOOKING_CREATED
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  LOGIN
  LOGOUT
  INVITED
  PLAN_CHANGED
  WHATSAPP_CONNECTED
  DOCUMENT_UPLOADED
}

// ============================================================
// PUBLIC SCHEMA — SHARED TABLES
// ============================================================

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?    @db.Timestamptz(6)

  // Relations
  members                 TenantMember[]
  invitations             Invitation[]
  refreshTokens           RefreshToken[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  locations               Location[]
  whatsappNumbers         WhatsAppNumber[]
  customers               Customer[]
  conversations           Conversation[]
  staff                   Staff[]
  services                Service[]
  bookings                Booking[]
  tenantReminderRules     TenantReminderRule[]
  scheduledReminders      ScheduledReminder[]
  tenantAiPrompts         TenantAIPrompt[]
  knowledgeBaseDocs       KnowledgeBaseDocument[]
  knowledgeBaseChunks     KnowledgeBaseChunk[]
  usageEvents             UsageEvent[]
  dailyUsageAggregates    DailyUsageAggregate[]
  auditLogs               AuditLog[]
  messageTemplates        TenantMessageTemplate[]
  locationBusinessHours   LocationBusinessHour[]
  messages                Message[]
  staffSchedules          StaffSchedule[]
  staffScheduleOverrides  StaffScheduleOverride[]
  bookingServices         BookingService[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  phone           String?
  passwordHash    String
  name            String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  twoFactorSecret  String?
twoFactorEnabled Boolean   @default(false)

  // Relations
  tenantMemberships       TenantMember[]
  refreshTokens           RefreshToken[]
  staff                   Staff[]
  notificationsPreference NotificationPreference[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]

  @@index([email])
  @@map("users")
}

model TenantMember {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      UserRole   @default(STAFF)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?  @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_members")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Invitation {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @db.Uuid
  email     String
  role      UserRole   @default(STAFF)
  token     String     @unique
  status    UserStatus @default(INVITED)
  expiresAt DateTime   @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("invitations")
}

model Plan {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  price     Int
  currency  String    @default("NPR")
  limits    Json      @default("{}")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @db.Uuid
  planId               String    @db.Uuid
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String
  currentPeriodStart   DateTime  @db.Timestamptz(6)
  currentPeriodEnd     DateTime  @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @db.Uuid
  subscriptionId  String        @db.Uuid
  stripeInvoiceId String?
  totalAmount     Int
  currency        String        @default("NPR")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime      @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?     @db.Timestamptz(6)

  // Relations
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id])
  lineItems    InvoiceLineItem[]

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String    @db.Uuid
  type        String
  description String
  quantity    Int
  unitAmount  Int
  totalAmount Int
  metadata    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model SystemAIPromptTemplate {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessType    String
  persona         String
  systemPrompt    String
  version         Int              @default(1)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  tenantAIPrompts TenantAIPrompt[]

  @@map("system_ai_prompt_templates")
}

model SystemMessageTemplate {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                 @unique
  category       String
  body           String
  variables      Json                   @default("[]")
  approvalStatus TemplateApprovalStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?              @db.Timestamptz(6)

  // Relations
  tenantTemplates TenantMessageTemplate[]

  @@map("system_message_templates")
}

model SystemReminderRule {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         ReminderRuleType @unique
  name         String
  timingOffset Int
  timingUnit   String
  defaultBody  String
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?        @db.Timestamptz(6)

  // Relations
  tenantRules TenantReminderRule[]

  @@map("system_reminder_rules")
}

// ============================================================
// TENANT-SCOPED TABLES
// ============================================================

model Location {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  address   String?
  phone     String?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessHours   LocationBusinessHour[]
  whatsappNumbers WhatsAppNumber[]
  staff           Staff[]
  services        Service[]
  bookings        Booking[]

  @@index([tenantId])
  @@map("locations")
}

model LocationBusinessHour {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  locationId String    @db.Uuid
  dayOfWeek  DayOfWeek
  openTime   String
  closeTime  String
  isOpen     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([tenantId])
  @@map("location_business_hours")
}

model WhatsAppNumber {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                     @db.Uuid
  locationId         String?                    @db.Uuid
  phoneNumber        String // E.164 format
  phoneNumberId      String? // Meta's phone_number_id
  whatsappBusinessId String? // WABA ID
  displayName        String
  qualityScore       Float? // 0.0 - 1.0
  verificationStatus WhatsAppVerificationStatus @default(PENDING)
  webhookUrl         String?
  isDefault          Boolean                    @default(false)
  isActive           Boolean                    @default(true)
  autoReplyEnabled   Boolean                    @default(true)
  greetingMessage    String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?                  @db.Timestamptz(6)

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location?      @relation(fields: [locationId], references: [id])
  conversations Conversation[]

  @@unique([phoneNumber])
  @@index([tenantId])
  @@index([phoneNumberId])
  @@map("whatsapp_numbers")
}

model Customer {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @db.Uuid
  name        String?
  phone       String
  email       String?
  whatsappId  String?
  optInStatus CustomerOptInStatus @default(PENDING)
  notes       String?
  tags        Json?               @default("[]")
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?           @db.Timestamptz(6)

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  bookings      Booking[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, whatsappId])
  @@map("customers")
}

model Conversation {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @db.Uuid
  customerId       String             @db.Uuid
  whatsappNumberId String             @db.Uuid
  state            ConversationState  @default(IDLE)
  status           ConversationStatus @default(OPEN)
  assignedStaffId  String?            @db.Uuid
  metadata         Json?              @default("{}")
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?          @db.Timestamptz(6)

  // Relations
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id])
  whatsappNumber WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id])
  assignedStaff  Staff?         @relation(fields: [assignedStaffId], references: [id])
  messages       Message[]
  bookings       Booking[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, state])
  @@index([tenantId, status])
  @@map("conversations")
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @db.Uuid
  conversationId String?        @db.Uuid
  messageType    MessageType
  direction      String
  content        String?
  metadata       Json?         @default("{}")
  status         MessageStatus @default(QUEUED)
  metaMessageId  String?       @unique
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, conversationId])
  @@index([tenantId, createdAt])
  @@map("messages")
}

model Staff {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String?   @db.Uuid
  locationId String?   @db.Uuid
  name       String
  phone      String?
  email      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  // Relations
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                   @relation(fields: [userId], references: [id])
  location      Location?               @relation(fields: [locationId], references: [id])
  bookings      Booking[]
  schedules     StaffSchedule[]
  overrides     StaffScheduleOverride[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("staff")
}

model StaffSchedule {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  staffId   String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isWorking Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([tenantId])
  @@map("staff_schedules")
}

model StaffScheduleOverride {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  staffId   String    @db.Uuid
  date      DateTime  @db.Date
  isWorking Boolean   @default(false)
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([tenantId])
  @@map("staff_schedule_overrides")
}

model Service {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  locationId  String?   @db.Uuid
  name        String
  description String?
  duration    Int
  price       Int
  currency    String    @default("NPR")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location        Location?        @relation(fields: [locationId], references: [id])
  bookingServices BookingService[]

  @@index([tenantId])
  @@map("services")
}

model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @db.Uuid
  customerId     String        @db.Uuid
  staffId        String?       @db.Uuid
  locationId     String?       @db.Uuid
  conversationId String?       @db.Uuid
  startTime      DateTime      @db.Timestamptz(6)
  endTime        DateTime      @db.Timestamptz(6)
  status         BookingStatus @default(PENDING)
  source         BookingSource @default(WHATSAPP)
  notes          String?
  totalAmount    Int?
  currency       String        @default("NPR")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  // Relations
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  staff        Staff?              @relation(fields: [staffId], references: [id])
  location     Location?           @relation(fields: [locationId], references: [id])
  conversation Conversation?       @relation(fields: [conversationId], references: [id])
  services     BookingService[]
  reminders    ScheduledReminder[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@map("bookings")
}

model BookingService {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  bookingId String    @db.Uuid
  serviceId String    @db.Uuid
  price     Int
  duration  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([tenantId])
  @@map("booking_services")
}

model TenantReminderRule {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @db.Uuid
  systemRuleId String?          @db.Uuid
  type         ReminderRuleType
  isEnabled    Boolean          @default(true)
  timingOffset Int?
  timingUnit   String?
  customBody   String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?        @db.Timestamptz(6)

  // Relations
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemRule SystemReminderRule? @relation(fields: [systemRuleId], references: [id])

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("tenant_reminder_rules")
}

model ScheduledReminder {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                  @db.Uuid
  bookingId   String                  @db.Uuid
  ruleType    ReminderRuleType
  message     String
  scheduledAt DateTime                @db.Timestamptz(6)
  sentAt      DateTime?               @db.Timestamptz(6)
  status      ScheduledReminderStatus @default(PENDING)
  error       String?
  attempts    Int                     @default(0)
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?               @db.Timestamptz(6)

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("scheduled_reminders")
}

model TenantAIPrompt {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @db.Uuid
  systemPromptBaseId String?   @db.Uuid
  persona            String
  language           String @default("auto")
  systemPrompt       String
  version            Int       @default(1)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  // Relations
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemPromptBase SystemAIPromptTemplate? @relation(fields: [systemPromptBaseId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, language]) 
  @@map("tenant_ai_prompts")
}

model KnowledgeBaseDocument {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @db.Uuid
  title       String
  fileName    String // Original filename (e.g., "services.pdf")
  fileSize    Int // Size in bytes (max 10MB)
  fileType    String // MIME type (e.g., "application/pdf")
  fileUrl     String? // Public R2 URL (e.g., "https://bucket.r2.dev/docs/abc123.pdf")
  storagePath String // R2 object key (e.g., "tenants/{tenantId}/kb/abc123.pdf")
  checksum    String // SHA-256 hash (prevents duplicate uploads)
  version     Int            @default(1)
  status      DocumentStatus @default(UPLOADING)
  metadata    Json           @default("{}") // e.g., { error: "Invalid PDF", processedAt: "2026-01-01" }

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeBaseChunk[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("knowledge_base_documents")
}

model KnowledgeBaseChunk {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                      @db.Uuid
  documentId String                      @db.Uuid
  content    String // Extracted text (max ~512 tokens)
  chunkIndex Int // Order within document (0-based)
  embedding  Unsupported("vector(1536)") // pgvector type (1536-dim for text-embedding-3-small)
  metadata   Json                        @default("{}") // e.g., { page: 1, section: "Pricing" }
  tokenCount Int? // Number of tokens in content (for cost tracking)
  isActive   Boolean                     @default(true) // Soft-delete flag

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeBaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, documentId])
  @@index([tenantId, isActive]) // Critical for RAG queries
  @@map("knowledge_base_chunks")
}

model UsageEvent {
