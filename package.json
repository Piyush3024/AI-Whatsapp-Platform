{
  "name": "whatsapp-ai-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install",
    "db:generate": "pnpm --filter @whatsapp-ai/db generate",
    "db:migrate:dev": "pnpm --filter @whatsapp-ai/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @whatsapp-ai/db migrate:deploy",
    "db:studio": "pnpm --filter @whatsapp-ai/db studio",
    "db:clean": "pnpm --filter @whatsapp-ai/db clean",
    "build:db": "pnpm --filter @whatsapp-ai/db generate"
  },
  "dependencies": {
    "@whatsapp-ai/db": "workspace:*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
